# Password Kryz, Matt and the team use to sign in. Leave empty only for local testing.
APP_PASSWORD=
# Where the database and uploaded PDFs live. On Railway, point this at a mounted volume (e.g. /data).
DATA_DIR=./data
# Optional: AI keys can also be entered on the Settings page inside the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional but recommended: a long random string used to sign login sessions, separate from APP_PASSWORD.
SESSION_SECRET=
